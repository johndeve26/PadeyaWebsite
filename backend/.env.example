APP_BASE_URL=https://padeya.com



# Replace before any real deployment — never commit real secrets
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14


EMAIL_PROVIDER=log
EMAIL_FROM=noreply@padeya.com
EMAIL_ENABLED=true
# Disable in-process outbox sweepers locally — they can freeze the API event loop.
EMAIL_QUEUE_ENABLED=false
PUSH_QUEUE_ENABLED=false
MESSAGING_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=0

