APP_NAME=Pàdéyá API
APP_ENV=development
DEBUG=false
#DEBUG=true
API_PREFIX=/api/v1
DEMO_MODE=true


# Prefer 127.0.0.1 over localhost on macOS (localhost can resolve to ::1 first).
#DATABASE_URL=postgresql+psycopg2://padeya:padeya@127.0.0.1:5432/padeya
DATABASE_URL=postgresql+psycopg2://neondb_owner:npg_r6eJI2KPDhsR@ep-fragrant-poetry-ayeu61jj.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis-cli --tls -u redis://default:AZ4fAAIgcDE4NzNjMWEyZTNlYTA0ZTliYjIyOTZmMGU0MGJkNGZkOQ@superb-elf-40479.upstash.io:6379


CORS_ORIGINS=https://padeya.com,https://www.padeya.com,https://your-project.vercel.app
FRONTEND_URL=https://padeya.com
APP_BASE_URL=https://padeya.com
# Shared with Next.js REVALIDATE_SECRET — server-to-server /api/revalidate/fan
# (directory/sitemap purge). Fan HTML itself is no-store; never commit a real secret.
#REVALIDATE_SECRET=




# Replace before any real deployment — never commit real secrets
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14


EMAIL_PROVIDER=log
EMAIL_FROM=noreply@padeya.com
EMAIL_ENABLED=true
# Disable in-process outbox sweepers locally — they can freeze the API event loop.
EMAIL_QUEUE_ENABLED=false
PUSH_QUEUE_ENABLED=false
MESSAGING_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=0

# Server-only Google Geocoding / Places (never expose to the browser).
GOOGLE_PLACES_API_KEY=

# AI Copilot + conversational assistant (server-only — never expose to the browser)
AI_ENABLED=false
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Ask Pàdéyá / Pàdéyá Copilot — default OFF; enable after migration + knowledge sync
ASSISTANT_ENABLED=false
ASSISTANT_PUBLIC_ENABLED=false
ASSISTANT_AUTHENTICATED_ENABLED=false
ASSISTANT_ACTIONS_ENABLED=false
ASSISTANT_EVENT_SEARCH_ENABLED=true
ASSISTANT_SUPPORT_DRAFTS_ENABLED=false
ASSISTANT_ADMIN_ENABLED=false
ASSISTANT_ANONYMOUS_RATE_LIMIT_PER_HOUR=30
ASSISTANT_AUTH_RATE_LIMIT_PER_HOUR=120
ASSISTANT_SESSION_RETENTION_DAYS=30
ASSISTANT_PUBLIC_SESSION_RETENTION_HOURS=24
ASSISTANT_KNOWLEDGE_SYNC_ENABLED=false
ASSISTANT_KNOWLEDGE_SITEMAP_URL=
ASSISTANT_MAX_TOOL_STEPS=4
ASSISTANT_MAX_OUTPUT_TOKENS=800
ASSISTANT_TOOL_TIMEOUT_SECONDS=8
ASSISTANT_PRIMARY_MODEL=
ASSISTANT_FAST_MODEL=