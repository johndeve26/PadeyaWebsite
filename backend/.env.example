# =============================================================================
# Pàdéyá env — Class A (boot-critical) vs Class B (admin-overridable)
# See docs/ADMIN_RUNTIME_SETTINGS_AUDIT.md and docs/ENVIRONMENT.md.
# Class A / env-only: never editable in Admin Runtime Settings.
# Class B: optional tunables; Admin → /admin/settings/runtime may override DB;
#          env remains fallback when no DB row.
# Class C secrets (SMTP/VAPID): specialist admin UIs only (encrypted/masked).
# =============================================================================

APP_NAME=Pàdéyá API
# Class A — env-only
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Local demo helper page + seed tooling (never true in production)
# Class A — env-only
DEMO_MODE=true
# Explicit merch/demo seed allow when NODE_ENV=production tooling (still blocked if APP_ENV=production)
# DEMO_SEED_ENABLED=true

# Class A — env-only
DATABASE_URL=postgresql+psycopg2://padeya:padeya@localhost:5432/padeya
# Used for analytics rate limits + messaging WebSocket multi-worker pub/sub.
# If Redis is unavailable locally, messaging uses in-memory fan-out (single API worker only).
# Class A — env-only
REDIS_URL=redis://localhost:6379/0

#EVENTS_NEARBY_RATE_LIMIT_PER_MINUTE=60

# Class A — env-only
CORS_ORIGINS=http://localhost:3000

# Replace before any real deployment — never commit real secrets.
# Production/staging refuse to start if SECRET_KEY is weak or shorter than 32 chars.
# Class A — env-only
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=180
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30

# Class A — env-only
FRONTEND_URL=http://localhost:3000

# Local event image uploads (served at /media/...)
MEDIA_ROOT=media_uploads
# Optional public origin for absolute /media/... URLs in API responses (emails, OG tags).
# Leave empty for relative /media/... paths (recommended with Next.js /media rewrites + ngrok frontend).
# Example: https://your-subdomain.ngrok-free.dev or https://api.padeya.com
MEDIA_PUBLIC_BASE_URL=

# Messaging chat attachments (safe v1: images + PDF/text/CSV/DOCX)
MESSAGING_ATTACHMENT_MAX_IMAGE_BYTES=5242880
MESSAGING_ATTACHMENT_MAX_DOC_BYTES=10485760
MESSAGING_ATTACHMENT_MAX_TOTAL_BYTES=15728640
MESSAGING_ATTACHMENT_MAX_COUNT=4
# Unbound staged uploads expire; in-process sweeper interval (0 = off)
MESSAGING_ATTACHMENT_ORPHAN_HOURS=24
MESSAGING_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=3600
# Private attachment storage (never public /media). local | s3 | r2 (s3/r2 not wired yet)
MESSAGING_ATTACHMENT_STORAGE_PROVIDER=local
MESSAGING_ATTACHMENT_STORAGE_ROOT=storage/message_attachments
# Short-lived signed ?d= tokens for <img src> (seconds)
MESSAGING_ATTACHMENT_DOWNLOAD_TTL_SECONDS=900
# Re-encode images to strip EXIF/metadata (Pillow)
MESSAGING_ATTACHMENT_STRIP_IMAGE_METADATA=true
# AV hook: noop (default — type/size only) | clamav (reserved, not wired)
MESSAGING_ATTACHMENT_SCANNER=noop

# Paystack: configure in Admin → System → Payment integration (not .env)

# Optional; falls back to SECRET_KEY
QR_SIGNING_SECRET=

# Transactional email: Admin → Email settings + Admin → Runtime Settings (email)
# (provider, SMTP, queue/worker tunables — not configured via .env)
# Class A — Fernet key for admin SMTP/VAPID ciphertext; never editable in admin
EMAIL_SETTINGS_ENCRYPTION_KEY=

# AI Copilot (optional — leave disabled for local/core flows)
# AI_ENABLED / AI_PROVIDER / AI_MODEL / AI_BASE_URL / limits — Class B (non-secret).
# AI_API_KEY — Class A / status-only (never editable in admin).
AI_ENABLED=false
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_HOUR=60

# Google Geocoding: Admin → System → Integrations (not .env)

# Merch abandoned cart recovery (hours / days) — Class B admin-overridable
# MERCH_CART_ABANDON_AFTER is an alias for hours idle before abandoned
MERCH_CART_ABANDON_AFTER=24
MERCH_CART_EXPIRE_AFTER_DAYS=14
MERCH_CART_RECOVERY_MIN_GAP_HOURS=72

# Analytics dedupe windows (seconds) — Class B admin-overridable
ANALYTICS_IMPRESSION_DEDUPE_SECONDS=300
ANALYTICS_DETAIL_VIEW_DEDUPE_SECONDS=1800
ANALYTICS_CHECKOUT_START_DEDUPE_SECONDS=3600
ANALYTICS_UNIQUE_CLICK_DEDUPE_SECONDS=86400
ANALYTICS_TRACK_RATE_LIMIT_PER_MINUTE=120
ANALYTICS_TRACK_BATCH_MAX_ITEMS=50
ANALYTICS_METADATA_MAX_KEYS=40
ANALYTICS_METADATA_MAX_BYTES=8192

# Ambassadors fraud / reward alerts — Class B admin-overridable
AMBASSADOR_TRACK_RATE_LIMIT_PER_MINUTE=60
AMBASSADOR_CLICK_SPIKE_WINDOW_SECONDS=300
AMBASSADOR_CLICK_SPIKE_THRESHOLD=40
# Admin alert when commission marked paid meets/exceeds this (NGN). 0 = off.
AMBASSADOR_HIGH_VALUE_REWARD_NGN=50000

# Browser push worker knobs — Class B (VAPID secrets stay on /admin/push/settings)
# PUSH_QUEUE_ENABLED / PUSH_WORKER_* / PUSH_MESSAGE_RATE_LIMIT_PER_HOUR
PUSH_QUEUE_ENABLED=true
PUSH_WORKER_POLL_SECONDS=20
PUSH_WORKER_BATCH_SIZE=50
PUSH_MESSAGE_RATE_LIMIT_PER_HOUR=12
