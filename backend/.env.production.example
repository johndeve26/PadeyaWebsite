# Pàdéyá API — production environment template
# Copy to backend/.env.production and fill real values.
# NEVER commit backend/.env.production or real secrets.

APP_NAME=Pàdéyá API
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1
DEMO_MODE=false

# Strong unique secrets (min 32 chars). Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
QR_SIGNING_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=180

# Overridden by docker-compose.prod.yml for in-network Postgres/Redis.
# Keep for non-Docker deploys:
DATABASE_URL=postgresql+psycopg2://padeya:CHANGE_ME@postgres:5432/padeya
REDIS_URL=redis://redis:6379/0

# Explicit HTTPS origins only — no localhost in production
CORS_ORIGINS=https://padeya.com,https://www.padeya.com
FRONTEND_URL=https://padeya.com

# Paystack: Admin → System → Payment integration (runtime_settings; not .env)

# Email: Admin → Email settings + Runtime Settings (not .env). Required host secret:
EMAIL_SETTINGS_ENCRYPTION_KEY=

# AI Copilot — keep false unless intentionally enabled; keys stay server-side
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_HOUR=60

# Public media — Cloudflare R2 (never expose access keys to the frontend)
MEDIA_STORAGE_PROVIDER=r2
R2_BUCKET_NAME=padeya-media
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.padeya.com
# Optional: keep MEDIA_ROOT for serving legacy /media/... rows still on disk
MEDIA_ROOT=media_uploads
