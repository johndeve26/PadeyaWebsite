NEXT_PUBLIC_APP_NAME=Pàdéyá
# For ngrok/single-tunnel dev: leave NEXT_PUBLIC_API_URL empty so /api and /media use same-origin rewrites.
#NEXT_PUBLIC_API_URL=
# Direct-to-backend local dev (no Next proxy):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_DEMO_MODE=true
# Public site origin for shareable referral / SEO links (defaults to https://padeya.com when unset/local).
#NEXT_PUBLIC_SITE_URL=https://padeya.com

# Google Maps Platform (browser). Enable Maps JavaScript API + Places API + Maps Embed API.
# Restrict the key by HTTP referrer in Google Cloud Console.
#NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
