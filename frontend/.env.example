NEXT_PUBLIC_APP_NAME=Pàdéyá
# For ngrok/single-tunnel dev: leave NEXT_PUBLIC_API_URL empty so /api and /media use same-origin rewrites.
#NEXT_PUBLIC_API_URL=
# Direct-to-backend local dev (no Next proxy):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_DEMO_MODE=true
# Public site origin for shareable referral links (optional).
# SEO canonicals ALWAYS use https://padeya.com — never localhost, Vercel preview,
# Render, Cloudflare tunnels, or legacy staging hosts.
# Indexing is production-only (APP_ENV=production and/or VERCEL_ENV=production;
# missing APP_ENV on a production Node build still allows indexing).
# Staging client bundles: set NEXT_PUBLIC_APP_ENV=staging so optional GA4 stays off.
#NEXT_PUBLIC_SITE_URL=https://padeya.com
#APP_ENV=development
#NEXT_PUBLIC_APP_ENV=staging
# Optional comma-separated https social profile URLs for Organization sameAs (never invent).
#NEXT_PUBLIC_SOCIAL_SAME_AS=https://instagram.com/padeya,https://x.com/padeya

# Search Console / Bing meta verification (optional). Prefer DNS TXT in production.
#GOOGLE_SITE_VERIFICATION=
#BING_SITE_VERIFICATION=
# NEXT_PUBLIC_* variants also work if the token must be available at build time:
#NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional GA4 — production + explicit consent only (never loads without Allow on /cookies).
#NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Server-only: shared with backend REVALIDATE_SECRET for POST /api/revalidate/fan
# (Bearer). Required for fan directory/sitemap purge after visibility changes.
# Never expose to the browser (no NEXT_PUBLIC_ prefix).
#REVALIDATE_SECRET=

# Google Maps Platform (browser). Enable Maps JavaScript API + Places API + Maps Embed API.
# Restrict the key by HTTP referrer in Google Cloud Console.
#NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
