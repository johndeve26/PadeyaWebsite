# Pàdéyá frontend — production build/runtime template
# Copy to frontend/.env.production (and/or export before compose build).
# NEVER commit frontend/.env.production or real secrets.
#
# NEXT_PUBLIC_* values are baked into the Next.js client bundle at build time.
# Point NEXT_PUBLIC_API_URL at your public API origin (HTTPS), not localhost.
# If unset on padeya.com, the client falls back to NEXT_PUBLIC_LIVE_API_URL or
# https://padeyawebsite.onrender.com (same-origin /api/v1 rewrites are not reliable on Vercel).

NEXT_PUBLIC_APP_NAME=Pàdéyá
NEXT_PUBLIC_API_URL=https://api.padeya.com
#NEXT_PUBLIC_LIVE_API_URL=https://padeyawebsite.onrender.com
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=https://padeya.com
# Explicit production SEO signal (recommended). Missing APP_ENV still allows
# indexing when NODE_ENV=production and VERCEL_ENV is unset or production.
APP_ENV=production

# Search Console / Bing (optional — prefer DNS TXT verification in production)
#GOOGLE_SITE_VERIFICATION=
#BING_SITE_VERIFICATION=

# Optional GA4 (loads only after user allows on /cookies in production)
#NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Maps Platform (browser). Enable Maps JavaScript API + Places API + Maps Embed API.
# Restrict the key by HTTP referrer in Google Cloud Console.
#NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Used by docker-compose.prod.yml host port mapping (optional)
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# Postgres credentials for compose (required)
POSTGRES_USER=padeya
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=padeya
